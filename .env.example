# ============================================================================
# Canada Productivity Intelligence - Environment Configuration (EXAMPLE)
# Copy this file to `.env` and fill in values. Never commit `.env`.
# No secrets are stored in this example file.
# ============================================================================

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
POSTGRES_USER=cpi_user
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=canada_productivity
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Prisma connection string (Docker Compose uses host `postgres`)
DATABASE_URL="postgresql://cpi_user:change_me_local_only@localhost:5432/canada_productivity?schema=public"

# ----------------------------------------------------------------------------
# Backend (Node/Express)
# ----------------------------------------------------------------------------
NODE_ENV=development
BACKEND_PORT=4000
# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Frontend (Vite)
# ----------------------------------------------------------------------------
# Base URL the React app uses to reach the backend API
VITE_API_BASE_URL=http://localhost:4000/api

# ----------------------------------------------------------------------------
# External Data Sources (official Government of Canada endpoints)
# These are public base URLs. Verify against provider documentation.
#   StatCan WDS docs:  https://www.statcan.gc.ca/en/developers/wds/user-guide
#   MSC GeoMet docs:   https://eccc-msc.github.io/open-data/msc-geomet/ogc_api_en/
# ----------------------------------------------------------------------------
# Statistics Canada Web Data Service (WDS) REST base URL
STATCAN_WDS_BASE_URL=https://www150.statcan.gc.ca/t1/wds/rest
# Environment Canada MSC GeoMet OGC API base URL
MSC_GEOMET_OGC_API_BASE_URL=https://api.weather.gc.ca
# Optional politeness delay between external requests (milliseconds)
DATA_SOURCE_REQUEST_DELAY_MS=250

# ----------------------------------------------------------------------------
# ML Service
# ----------------------------------------------------------------------------
# Directory (inside ml/) where model artifacts are written
ML_ARTIFACTS_DIR=artifacts
# Random seed used across ML pipelines for reproducibility
ML_RANDOM_SEED=42
